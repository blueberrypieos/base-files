# /etc/group: the system groups and their members. Libinfo's file module
# reads it. All groups are in OpenDirectory, in /var/db/dslocal. In
# single-user mode, and while opendirectoryd is not running, only the
# groups and members here are known.
nobody:*:-2:
nogroup:*:-1:
wheel:*:0:root
daemon:*:1:root
kmem:*:2:root
sys:*:3:root
tty:*:4:root
operator:*:5:root
mail:*:6:
bin:*:7:
staff:*:20:root
input:*:97:
admin:*:80:root
_sshd:*:75:
_apt:*:42:
