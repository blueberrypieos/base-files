set -e
if [ "$1" = configure ]; then
	for d in /private/tmp /private/var/tmp /private/var/folders/zz; do
		dpkg-statoverride --list "$d" > /dev/null ||
			dpkg-statoverride --update --add '#0' '#0' 1777 "$d"
	done
fi
